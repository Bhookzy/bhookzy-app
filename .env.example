# ─────────────────────────────────────────────────────────────────────────────
# Bhookzy — environment variables.  Copy to ".env" for local use; on a host
# (Render / Railway / VPS) set the same names in its "Environment" settings.
# NEVER commit your real .env file, and never put these values in frontend code.
# ─────────────────────────────────────────────────────────────────────────────

# --- Required ---------------------------------------------------------------
# PostgreSQL connection string. Works with Supabase, Neon, Render/Railway Postgres or your own server.
#   Supabase: Project Settings → Database → Connection string → "URI" (use the pooled / Transaction one on hosts with IPv4 only)
#   Neon:     Dashboard → Connection details
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/bhookzy
# auto = encrypted connection unless the host is localhost.  Use "disable" only for a local, unencrypted Postgres.
DATABASE_SSL=auto

# --- Server -----------------------------------------------------------------
NODE_ENV=production
PORT=3000
# Public https address of the site (used for links, sitemap, canonical URL and the admin CSRF check). No trailing slash.
PUBLIC_URL=https://www.bhookzy.com
# How many reverse proxies sit in front of the app (Render/Railway/Nginx = 1). Needed for correct client IPs + rate limits.
TRUST_PROXY=1
# Admin cookie is sent only over HTTPS in production. Set to "false" ONLY to test production mode on plain http://localhost.
COOKIE_SECURE=true
# Extra origins allowed to call the admin API (comma separated). Normally leave empty.
ALLOWED_ORIGINS=

# --- First owner account (only for hosts with NO shell access) --------------
# Deploy once with both set → the owner is created → then DELETE both variables.
# If you have a shell, skip these and run:  npm run create-admin
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Owner

# --- Optional tuning --------------------------------------------------------
AUTO_MIGRATE=true            # apply database migrations on start
AUTO_SEED=true               # load the 270-dish starter menu ONCE into an empty database
SESSION_TTL_HOURS=12         # admin sign-out after this much inactivity
SESSION_MAX_DAYS=7           # admin must sign in again after this many days
APP_TIMEZONE=Asia/Kolkata
MAX_UPLOAD_MB=4              # max size of an uploaded photo (it is re-encoded to WebP)
LOG_LEVEL=info

# --- Payments (reserved) -----------------------------------------------------
# Razorpay is NOT active. When you integrate it, keep these on the server only (see docs/SETUP.md → "Razorpay later").
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
